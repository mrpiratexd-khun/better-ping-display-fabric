{
  "schemaVersion": 1,
  "id": "betterpingdisplay",
  "version": "${version}",

  "name": "Better Ping Display",
  "description": "Shows the actual ping number instead of just bars in the player list!",
  "authors": [
    "Quintinity",
    "MrPirateXD_Khun",
    "Claude"
  ],

  "contact": {
    "homepage": "https://github.com/mrpiratexd-khun/better-ping-display-fabric",
    "sources": "https://github.com/mrpiratexd-khun/better-ping-display-fabric",
    "issues": "https://github.com/mrpiratexd-khun/better-ping-display-fabric/issues"
  },

  "license": "MIT",
  "icon": "assets/betterpingdisplay/icon.png",

  "environment": "client",
  "entrypoints": {
    "main": [
      "com.vladmarica.betterpingdisplay.BetterPingDisplayMod"
    ],
    "modmenu": [
      "com.vladmarica.betterpingdisplay.integ.ModMenuIntegration"
    ]
  },
  "mixins": [
    "betterpingdisplay.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_version}"
  },

  "suggests": {
    "yet_another_config_lib_v3": ">=3.9.6+26.2-fabric"
  },

  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
